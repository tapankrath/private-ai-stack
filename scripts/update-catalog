#!/usr/bin/env python3
"""Re-verify the model catalog against Hugging Face model cards.

This is an EXPLICIT, AUDITED EGRESS STEP. It refuses to run without --allow-egress,
contacts only huggingface.co, sends only public repo ids (never profile data), and appends
every request to logs/egress-audit.log.

It does not edit config/model_catalog.yaml (that file is reviewed by a human). It writes
config/catalog_verification.yaml with, per model: the license on the model card, whether it
matches the catalog, and the repo commit sha to pin downloads to.

Usage:
  scripts/update-catalog --allow-egress            # check every entry with an hf repo
  scripts/update-catalog --allow-egress --only qwen3-8b
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import sys
import urllib.request
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
CATALOG = ROOT / "config" / "model_catalog.yaml"
OUT = ROOT / "config" / "catalog_verification.yaml"
AUDIT = ROOT / "logs" / "egress-audit.log"
HF_API = "https://huggingface.co/api/models/"

# How catalog license names map to Hugging Face license tags (extend as needed).
LICENSE_TAGS = {
    "Apache-2.0": {"apache-2.0"},
    "MIT": {"mit"},
    "Llama 3.1 Community License": {"llama3.1"},
    "Llama 3.3 Community License": {"llama3.3"},
    "Gemma Terms of Use": {"gemma"},
    "Qwen Research License": {"other", "qwen-research"},
    "Mistral Non-Production License": {"other", "mnpl"},
    "Qwen Community License 1.0": {"other", "qwen-community"},
}


def audit(line: str) -> None:
    AUDIT.parent.mkdir(exist_ok=True)
    with open(AUDIT, "a", encoding="utf-8") as fh:
        fh.write(f"{dt.datetime.now(dt.timezone.utc).isoformat()} update-catalog {line}\n")


def fetch_hf(repo: str) -> dict:
    url = HF_API + repo
    audit(f"GET {url}")
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "catalog-verify"}), timeout=30) as r:
        return json.loads(r.read())


def card_license(info: dict) -> str | None:
    lic = (info.get("cardData") or {}).get("license")
    if lic:
        return str(lic).lower()
    for tag in info.get("tags", []):
        if tag.startswith("license:"):
            return tag.split(":", 1)[1].lower()
    return None


def verify(models: list[dict], fetch=fetch_hf, only: str | None = None) -> dict:
    results = {}
    today = dt.date.today().isoformat()
    for m in models:
        if only and m["id"] != only:
            continue
        repo = m.get("runtimes", {}).get("hf")
        if not repo:
            results[m["id"]] = {"status": "skipped", "reason": "no Hugging Face repo"}
            continue
        try:
            info = fetch(repo)
        except Exception as exc:  # noqa: BLE001
            results[m["id"]] = {"status": "error", "repo": repo, "error": str(exc)}
            continue
        lic = card_license(info)
        expected = LICENSE_TAGS.get(m["license"], {m["license"].lower()})
        results[m["id"]] = {
            "status": "ok" if lic in expected else "LICENSE MISMATCH - review before use",
            "repo": repo,
            "catalog_license": m["license"],
            "card_license": lic,
            "pin_revision": info.get("sha"),
            "gated": info.get("gated", False),
            "checked": today,
        }
    return results


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--allow-egress", action="store_true", help="required: confirms this outbound step")
    ap.add_argument("--only", help="check a single catalog id")
    args = ap.parse_args(argv)
    if not args.allow_egress:
        print("Refusing: this step contacts huggingface.co. Re-run with --allow-egress.", file=sys.stderr)
        return 2
    catalog = yaml.safe_load(CATALOG.read_text())
    results = verify(catalog["models"], only=args.only)
    OUT.write_text("# Generated by scripts/update-catalog. Review mismatches by hand.\n" +
                   yaml.safe_dump(results, sort_keys=True))
    bad = [k for k, v in results.items() if v["status"] not in {"ok", "skipped"}]
    print(f"Checked {len(results)} entries; {len(bad)} need review: {', '.join(bad) or 'none'}")
    print(f"Wrote {OUT.relative_to(ROOT)}; audit log: {AUDIT.relative_to(ROOT)}")
    return 1 if bad else 0


if __name__ == "__main__":
    raise SystemExit(main())
